port: 7890
socks-port: 7891
mixed-port: 7897
mode: rule
unified-delay: true
keep-alive-interval: 15
log-level: info
allow-lan: false
ipv6: false
external-controller: 127.0.0.1:9097

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.arpa"
    - "time.*.com"
    - "ntp.*.com"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "localhost.ptlogin2.qq.com"
  respect-rules: true
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  proxy-server-nameserver:
    - "https://dns.alidns.com/dns-query"
    - "https://doh.pub/dns-query"
    - 223.5.5.5
    - 119.29.29.29
  direct-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - "https://dns.alidns.com/dns-query"
    - "https://doh.pub/dns-query"
  nameserver-policy:
    "geosite:geolocation-!cn":
      - "https://cloudflare-dns.com/dns-query#🚀 独享-AI与代码"
      - "https://1.1.1.1/dns-query#🚀 独享-AI与代码"
      - "https://dns.google/dns-query#🚀 独享-AI与代码"
    "geosite:cn,private":
      - 223.5.5.5
      - 119.29.29.29
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
    "rule-set:direct":
      - 223.5.5.5
      - 119.29.29.29
      - "https://dns.alidns.com/dns-query"
      - "https://doh.pub/dns-query"
  nameserver:
    - "https://cloudflare-dns.com/dns-query#🚀 独享-AI与代码"
    - "https://1.1.1.1/dns-query#🚀 独享-AI与代码"
    - "https://dns.google/dns-query#🚀 独享-AI与代码"

tun:
  enable: true
  stack: mixed
  device: Mihomo
  dns-hijack:
    - "any:53"
    - "tcp://any:53"
  auto-route: true
  strict-route: true
  auto-detect-interface: true
  inet4-address:
    - 198.18.0.1/30

proxies:
  - name: "{{NODE_NAME}}"
    type: vless
    server: {{SERVER_IP}}
    port: {{PORT}}
    uuid: {{UUID}}
    network: tcp
    udp: true
    tls: true
    flow: {{FLOW}}
    servername: {{SNI}}
    reality-opts:
      public-key: {{PUBLIC_KEY}}
      short-id: {{SHORT_ID}}
    client-fingerprint: {{FINGERPRINT}}

proxy-groups:
  # 严格禁止加入 DIRECT：节点失效即断网，绝不回落本地直连
  - name: "🚀 独享-AI与代码"
    type: select
    proxies:
      - "{{NODE_NAME}}"

  - name: "🌐 谷歌与Gemini"
    type: select
    proxies:
      - "{{NODE_NAME}}"

  - name: "🐟 漏网之鱼"
    type: select
    proxies:
      - "{{NODE_NAME}}"

rule-providers:
  direct:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt"
    path: ./ruleset/direct.yaml
    interval: 86400
  cncidr:
    type: http
    behavior: ipcidr
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/cncidr.txt"
    path: ./ruleset/cncidr.yaml
    interval: 86400

